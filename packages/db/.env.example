# packages/db — Prisma tooling environment (generate, migrate, studio).
#   cp .env.example .env
# The Prisma CLI auto-loads this file when run from packages/db. Real
# environment variables always win over this file.

# Row-level access only (cougny_app). What the running apps use, and what
# `pnpm db:studio` browses with.
DATABASE_URL=postgresql://cougny_app:cougny_app@localhost:5432/cougny?schema=public

# Schema owner (cougny_migrator). Everything the Prisma CLI does is DDL, so
# `prisma migrate` connects with this instead — see prisma.config.ts. Falls back
# to DATABASE_URL when unset, which is what a single-role scratch database wants.
MIGRATE_DATABASE_URL=postgresql://cougny_migrator:cougny_migrator@localhost:5432/cougny?schema=public

# Bootstrap owner: the only role permitted to CREATE ROLE, and therefore the one
# that creates the two above. POSTGRES_USER locally, neondb_owner on Neon. Used
# by `pnpm db:provision` and nothing else — no app ever holds it.
# PROVISION_DATABASE_URL=postgresql://cougny:cougny@localhost:5432/cougny
# POSTGRES_MIGRATOR_PASSWORD=
# POSTGRES_APP_PASSWORD=

# Scratch database Prisma replays the migration history into when it needs to
# know what the schema *should* look like — drift detection and
# `migrate diff --from-migrations`. Optional on a local server, where Prisma
# creates and drops a temporary database itself. Required on Neon, whose roles
# cannot CREATE DATABASE: point it at a second, empty Neon database.
# SHADOW_DATABASE_URL=
