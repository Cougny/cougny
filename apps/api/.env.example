# apps/api — API service environment.
#   cp .env.example .env
# Real environment variables always win over this file.

NODE_ENV=development

# --- HTTP server ---
API_HOST=0.0.0.0
API_PORT=4000

# --- Database (Prisma via @cougny/db) ---
# cougny_app: rows only. Schema changes go through cougny_migrator in
# packages/db, so a compromised API process cannot alter or drop anything.
DATABASE_URL=postgresql://cougny_app:cougny_app@localhost:5432/cougny?schema=public

# --- Auth ---
# Secret used to sign short-lived session/auth tokens (min 16 chars).
AUTH_JWT_SECRET=dev-change-me-in-production

# --- CORS ---
# Comma-separated list of browser origins allowed to call the API.
SIGNALING_ALLOWED_ORIGINS=http://localhost:3000

# --- WebRTC ICE (coturn) ---
# STUN is public; TURN uses coturn's REST-API (use-auth-secret) shared secret.
# The API mints ephemeral HMAC credentials from this secret — clients never see it.
STUN_URL=stun:localhost:3478
TURN_URL=turn:localhost:3478
TURN_STATIC_AUTH_SECRET=dev-turn-shared-secret-change-me
# TTL (seconds) for a minted TURN credential.
TURN_CREDENTIAL_TTL=86400

# --- Accounts ---
# Where the browser-facing app lives. Email links and OAuth hand-offs point
# here, and this is the only host they are ever allowed to target.
WEB_APP_URL=http://localhost:3000
# This API's own externally reachable origin. OAuth redirect_uri values are
# built from it, so it must match what is registered with each provider.
API_PUBLIC_URL=http://localhost:4000

# Access tokens are short-lived; the refresh cookie is what keeps a user signed
# in, and it rotates on every use.
AUTH_ACCESS_TOKEN_TTL=900
AUTH_REFRESH_TOKEN_TTL=2592000
# Set to a shared parent domain (e.g. .cougny.com) when the API and web app are
# on different subdomains. Leave unset for localhost.
# AUTH_COOKIE_DOMAIN=

# --- Social sign-in (optional) ---
# Each provider's button appears only once both of its values are set.
# Google:  https://console.cloud.google.com/apis/credentials
#   Authorized redirect URI: <API_PUBLIC_URL>/v1/auth/oauth/google/callback
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Discord: https://discord.com/developers/applications
#   Redirect URI: <API_PUBLIC_URL>/v1/auth/oauth/discord/callback
# DISCORD_OAUTH_CLIENT_ID=
# DISCORD_OAUTH_CLIENT_SECRET=

# --- Passkeys (WebAuthn) ---
# The relying party id must be the registered domain the web app is served from
# (or a parent of it). Defaults to the hostname of WEB_APP_URL, which is right
# for local development and most single-domain deployments.
# WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=Cougny

# --- Transactional mail ---
# Verification and password-reset links. With SMTP_URL unset, messages are
# written to the log instead of sent — fine locally, not for production.
# Any SMTP provider works; production uses Resend, whose bridge takes the
# literal username "resend" and an API key as the password:
#   SMTP_URL=smtp://resend:re_YOUR_API_KEY@smtp.resend.com:587
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# Must be an address on a domain verified with the provider, or sends bounce.
MAIL_FROM=Cougny <no-reply@localhost>
